# WordPress Configuration
WP_SITE_URL=https://digital-income7771.com
WP_USERNAME=your_wp_username
WP_PASSWORD=your_wp_password
WP_REST_API_KEY=your_rest_api_key

# Claude API
CLAUDE_API_KEY=sk-ant-xxxxx

# Google AdSense
ADSENSE_PUBLISHER_ID=pub-xxxxxxxxxxxxxxxx
ADSENSE_PROPERTY_ID=ca-pub-xxxxxxxxxxxxxxxx

# Coupang API
COUPANG_API_KEY=your_coupang_api_key
COUPANG_SECRET_KEY=your_coupang_secret_key
COUPANG_AFFILIATE_ID=your_affiliate_id

# Google Analytics
GOOGLE_ANALYTICS_PROPERTY_ID=G-XXXXXXXXXX
GOOGLE_SERVICE_ACCOUNT_JSON=path/to/service-account.json

# Content Generation
ORIGINAL_CONTENT_MIN_LENGTH=200
SIMILARITY_THRESHOLD=0.80
DAILY_POST_COUNT=1

# Pinterest (Optional)
PINTEREST_ACCESS_TOKEN=your_pinterest_token
PINTEREST_PINS_PER_POST=3

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/blog_automation.log
